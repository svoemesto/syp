# Шаблон. Скопируйте в .env.local-tracker и заполните.
# Токен: OpenProject UI → My Account → Access Tokens → Generate.
# Или сгенерировать автоматически: tools/install-tracker.sh [bootstrap]
TRACKER_URL=http://localhost:8080
TRACKER_USER=ai-agent
TRACKER_API_TOKEN=
TRACKER_AGENT_USER=ai-agent
TRACKER_LOG_LEVEL=info
TRACKER_HTTP_TIMEOUT=30
