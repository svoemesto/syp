# SYP — пример файла окружения развёртывания.
#
# Скопируйте в deploy/.env и заполните. Сам файл deploy/.env вне системы
# контроля версий (constitution VIII.1, VIII.2):
#
#   cp deploy/.env.example deploy/.env
#
# Значения секретов НЕ коммитятся. Пустые значения для секретов здесь
# намеренно оставлены пустыми: дефолт, который выглядит рабочим, опаснее
# отсутствия значения (constitution VIII.5).
#
# Порты: веб — из диапазона 7910–7999, хранилище — из 9020–9099
# (research.md Т-22). Занятые на машине порты: 7906, 7907, 7980, 7981, 9001,
# 9088, 8080, 8897, 8898, 80, 3080 — они не используются.

# --- Порты, публикуемые на машине администратора ---------------------------

# PostgreSQL 16, контейнер syp-db
SYP_DB_HOST_PORT=7910

# Бэкенд админки, контейнер syp-admin-app
SYP_ADMIN_APP_HOST_PORT=7911

# Фронтенд админки через nginx, контейнер syp-admin-web
SYP_ADMIN_WEB_HOST_PORT=7912

# Бэкенд публичной части, контейнер syp-public-app
SYP_PUBLIC_APP_HOST_PORT=7913

# Фронтенд публичной части через nginx, контейнер syp-public-web
SYP_PUBLIC_WEB_HOST_PORT=7914

# Объектное хранилище MinIO, контейнер syp-storage: API и консоль
SYP_STORAGE_HOST_PORT=9020
SYP_STORAGE_CONSOLE_HOST_PORT=9021

# --- База данных -----------------------------------------------------------

SYP_DB_NAME=syp
SYP_DB_USER=syp
# ОБЯЗАТЕЛЬНО ЗАПОЛНИТЬ. Пароль базы, никакого значения по умолчанию.
SYP_DB_PASSWORD=

# --- Объектное хранилище ---------------------------------------------------

SYP_STORAGE_USER=
# ОБЯЗАТЕЛЬНО ЗАПОЛНИТЬ. Пароль MinIO.
SYP_STORAGE_PASSWORD=
# Корзина артефактов на SSD: листы превью, модели, канонические байты сценариев.
# Готовые видеофайлы здесь не хранятся — они остаются на машине пользователя
# (ADR-0009).
SYP_STORAGE_BUCKET=syp-artifacts

# --- Параллелизм воркера заданий -------------------------------------------
#
# Значения — параметры развёртывания, а не константы кода (Р-13). Задания,
# требующие видеокарты, выполняются строго по одному.

SYP_WORKER_CONCURRENCY=2
SYP_GPU_CONCURRENCY=1

# --- Нотификации SSE --------------------------------------------------------
#
# Интервал сердцебия потока событий, секунды. Сервер шлёт комментарий `:heartbeat`
# через этот промежуток, чтобы прокси не счёл живое соединение зависшим.
# Клиентский таймаут обязан быть БОЛЬШЕ этого значения, иначе живой поток
# успеет признаться мёртвым (ADR-0017).

SYP_SSE_HEARTBEAT_SECONDS=15

# Число попыток переподключения подряд и паузы между ними, миллисекунды.
# Значения уходят в образ админского фронтенда аргументами сборки. После
# исчерпания попыток подписка останавливается и говорит об этом словами, а
# повтор делает оператор: молчаливый бесконечный повтор выглядит как живой
# интерфейс с застывшими данными.

SYP_SSE_MAX_RECONNECT_ATTEMPTS=5
SYP_SSE_RECONNECT_BASE_MS=1000
SYP_SSE_RECONNECT_MAX_MS=30000

# --- Ключ подписи сценария сборки ------------------------------------------
#
# Закрытый ключ читается ТОЛЬКО из переменной окружения и живёт только в
# контейнере админки (ADR-0011). В репозитории его нет.
#
# Сгенерировать пару:
#   bash deploy/do.sh keys_generate key1
#
# Команда печатает обе части в base64: закрытый ключ — в
# SYP_SIGNING_PRIVATE_KEY, открытый — в SYP_SIGNING_PUBLIC_KEY. Идентификатор
# ключа — свободное имя версии: при его смене прежние сценарии остаются
# проверяемыми по старому ключу.

SYP_SIGNING_KEY_ID=
# ОБЯЗАТЕЛЬНО ЗАПОЛНИТЬ, если сценарии подписываются на этой машине.
SYP_SIGNING_PRIVATE_KEY=
SYP_SIGNING_PUBLIC_KEY=
# Момент, с которого ключ считается доверенным, в виде 2026-10-02T00:00:00Z.
# Публичная часть отдаёт его вместе с ключом, чтобы воркер видел, какой ключ
# новее. Пустое значение равносильно «доверен с самого начала».
SYP_SIGNING_KEY_NOT_BEFORE=

# --- Внешние программы -----------------------------------------------------
#
# Пути к программам фиксированы настройкой развёртывания и не приходят ни из
# данных, ни из задания, ни от пользователя: путь из данных — это путь из
# интернета в командную строку (ADR-0010, ограничение 2).

SYP_FFPROBE_PATH=/usr/bin/ffprobe

# --- Детектор лиц на видеокарте ----------------------------------------------
#
# Детектор работает внутри контейнера syp-admin-app: седьмого контейнера
# детекции в стеке нет и быть не может (constitution V, research.md Т-01,
# Т-20). Пути к программе и к модели фиксированы настройкой развёртывания и
# не приходят ни из данных, ни из задания, ни от пользователя (ADR-0010,
# ограничение 2). Секретов здесь нет.
#
# ПУСТОЕ значение SYP_FACE_DETECTOR_PATH означает: детектора нет. Бэкенд
# соберёт заглушку, которая объявляет себя заглушкой, и прогон анализа
# напишет это в тексте результата. Пустой результат заглушки нельзя выдать
# за детекцию, поэтому молчаливого режима здесь нет.
#
# Модель кладётся в образ из deploy/models/ и в git не попадает: скачивается
# по инструкции из measurements/m-01-gpu-runtime.md. Лицензия модели (MIT)
# лежит рядом и коммитится.

SYP_FACE_DETECTOR_PATH=/opt/syp/face-detector/bin/syp-face-detector
SYP_FACE_MODEL_PATH=/opt/syp/face-detector/models/face_detection_yunet_2023mar.onnx
# Вид модели: yunet, scrfd или retinaface. Подробности в deploy/models/README.md.
SYP_FACE_MODEL_KIND=yunet
# Провайдер вычислений onnxruntime. CUDAExecutionProvider — видеокарта,
# CPUExecutionProvider — медленный запасной путь для машины без карты.
SYP_FACE_PROVIDER=CUDAExecutionProvider
# Размер входа сети детектора в пикселях. Модель YuNet обучена на 640x640;
# значение меняется только вместе с моделью.
SYP_FACE_INPUT_WIDTH=640
SYP_FACE_INPUT_HEIGHT=640
# Порог уверенности и порог перекрытия рамок. Подбираются замером (М-02);
# значения ниже — исходные из репозитория модели, они не подогнаны под
# фильм.
# Порог подобран замером М-02 на размеченной выборке, а не взят из примера
# репозитория модели: 0,9 на наших данных не находит ни одного лица.
# Подробности и обоснование — measurements/m-02-models.md.
SYP_FACE_SCORE_THRESHOLD=0.2
SYP_FACE_NMS_THRESHOLD=0.3
# Сколько видеокарт отдаётся контейнеру админки: all — все карты машины.
SYP_GPU_COUNT=all

# --- Исходные видеофайлы ---------------------------------------------------
#
# Корень дерева исходников на машине администратора. Монтируется в контейнер
# админки только для чтения: исходные файлы никогда не изменяются.
# Путь передаётся оператором и не является секретом.

SYP_SOURCE_ROOT=/disks/HDD_16Tb_Clouds/GOT

# Сознательная сборка из некоммит��нного или устаревшего состояния.
# По умолчанию do.sh build_* отказывает, если дерево отстаёт от master:
# образ из старого кода выглядит собранным, а правки в нём нет.
SYP_ALLOW_STALE_BUILD=0
