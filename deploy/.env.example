# SYP — пример файла окружения развёртывания.
#
# Скопируйте в deploy/.env и заполните. Сам файл deploy/.env вне системы
# контроля версий (constitution VIII.1, VIII.2):
#
#   cp deploy/.env.example deploy/.env
#
# Значения секретов НЕ коммитятся. Пустые значения для секретов здесь
# намеренно оставлены пустыми: дефолт, который выглядит рабочим, опаснее
# отсутствия значения (constitution VIII.5).
#
# Порты: веб — из диапазона 7910–7999, хранилище — из 9020–9099
# (research.md Т-22). Занятые на машине порты: 7906, 7907, 7980, 7981, 9001,
# 9088, 8080, 8897, 8898, 80, 3080 — они не используются.

# --- Порты, публикуемые на машине администратора ---------------------------

# PostgreSQL 16, контейнер syp-db
SYP_DB_HOST_PORT=7910

# Бэкенд админки, контейнер syp-admin-app
SYP_ADMIN_APP_HOST_PORT=7911

# Фронтенд админки через nginx, контейнер syp-admin-web
SYP_ADMIN_WEB_HOST_PORT=7912

# Бэкенд публичной части, контейнер syp-public-app
SYP_PUBLIC_APP_HOST_PORT=7913

# Фронтенд публичной части через nginx, контейнер syp-public-web
SYP_PUBLIC_WEB_HOST_PORT=7914

# Объектное хранилище MinIO, контейнер syp-storage: API и консоль
SYP_STORAGE_HOST_PORT=9020
SYP_STORAGE_CONSOLE_HOST_PORT=9021

# --- База данных -----------------------------------------------------------

SYP_DB_NAME=syp
SYP_DB_USER=syp
# ОБЯЗАТЕЛЬНО ЗАПОЛНИТЬ. Пароль базы, никакого значения по умолчанию.
SYP_DB_PASSWORD=

# --- Объектное хранилище ---------------------------------------------------

SYP_STORAGE_USER=
# ОБЯЗАТЕЛЬНО ЗАПОЛНИТЬ. Пароль MinIO.
SYP_STORAGE_PASSWORD=
# Корзина артефактов на SSD: листы превью, модели, канонические байты сценариев.
# Готовые видеофайлы здесь не хранятся — они остаются на машине пользователя
# (ADR-0009).
SYP_STORAGE_BUCKET=syp-artifacts

# --- Параллелизм воркера заданий -------------------------------------------
#
# Значения — параметры развёртывания, а не константы кода (Р-13). Задания,
# требующие видеокарты, выполняются строго по одному.

SYP_WORKER_CONCURRENCY=2
SYP_GPU_CONCURRENCY=1

# --- Ключ подписи сценария сборки ------------------------------------------
#
# Закрытый ключ читается ТОЛЬКО из переменной окружения и живёт только в
# контейнере админки (ADR-0011). В репозитории его нет.
#
# Сгенерировать пару:
#   bash deploy/do.sh keys_generate key1
#
# Команда печатает обе части в base64: закрытый ключ — в
# SYP_SIGNING_PRIVATE_KEY, открытый — в SYP_SIGNING_PUBLIC_KEY. Идентификатор
# ключа — свободное имя версии: при его смене прежние сценарии остаются
# проверяемыми по старому ключу.

SYP_SIGNING_KEY_ID=
# ОБЯЗАТЕЛЬНО ЗАПОЛНИТЬ, если сценарии подписываются на этой машине.
SYP_SIGNING_PRIVATE_KEY=
SYP_SIGNING_PUBLIC_KEY=

# --- Исходные видеофайлы ---------------------------------------------------
#
# Корень дерева исходников на машине администратора. Монтируется в контейнер
# админки только для чтения: исходные файлы никогда не изменяются.
# Путь передаётся оператором и не является секретом.

SYP_SOURCE_ROOT=/disks/HDD_16Tb_Clouds/GOT
