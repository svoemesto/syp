# syntax=docker/dockerfile:1.7
# SYP — образ фронтенда.
#
# Собирается из каталога фронтенда: контекст сборки — сам каталог
# (`syp-admin-web` или `syp-public-web`). Базовый образ — `nginx:stable`,
# а не `nginx:alpine`: compose запускает его через `/bin/bash -c`
# (AGENTS.md § Tier-1 Hard Gate Build/Deploy/Containers).

FROM node:22-alpine AS builder

WORKDIR /build

COPY package.json package-lock.json* ./
# Кеш npm в слое BuildKit, как и кеш pip в образе бэкенда: без него каждая
# пересборка фронтенда тянет все пакеты заново и упирается в таймаут сети.
# Плюс увеличенные таймауты: с машины сеть медленная, и стандартных 5 минут
# на чтение не хватает (наблюдалось ETIMEDOUT при exit code 146).
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm ci --no-audit --no-fund --fetch-timeout=600000 \
    || npm install --no-audit --no-fund --fetch-timeout=600000

COPY . .
RUN npm run build

FROM nginx:stable

COPY --from=builder /build/dist /usr/share/nginx/html
# Upstream подставляется на месте: имя сервиса совпадает с именем контейнера
# бэкенда, а Dockerfile общий для обоих фронтендов.
COPY nginx.conf /etc/nginx/templates/default.conf.template

EXPOSE 80
