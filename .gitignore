# секреты — никогда не коммитить (AGENTS.md § Secrets & git hygiene)
.env
.env.local-tracker
deploy/.env
deploy/do.env
*.key
*.pem
*.p12
*.pfx
*.p8
# журналы работы — локальные, в репозитории им не место
logs/
.gradle/
.kotlin/
out/
*.hprof
.docker/
node_modules/
dist/
build/
*.log
.gradle-*/
.idea/
*.iml

# Рабочие каталоги проекта: изоляция субагентов и выгрузка данных.
# Вне папки проекта ничего не создаётся (решение владельца 2026-10-02).
.worktrees/
.data/
# Файлы моделей детектора лиц: вес модели — не код, и в git ему не место.
# Модель скачивается по инструкции из measurements/m-01-gpu-runtime.md и
# кладётся сюда. Лицензия модели рядом с ней коммитится: лицензия обязана
# быть в репозитории, файл модели — нет.
deploy/models/*.onnx
deploy/models/*.pt
deploy/models/*.bin

# Окружения Python и виртуальные машины. Среда исполнения для видеокарты
# (torch, onnxruntime-gpu) стоит в .data/venv-gpu и весит единицы гигабайт;
# в репозиторий ей нельзя попасть ни при каком расположении (решение владельца
# 2026-10-03).
venv/
.venv/
*/venv/
__pycache__/
*.pyc
